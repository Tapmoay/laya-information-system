{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laya.local/contracts/capability-contract/1.0.0",
  "title": "Capability Contract",
  "description": "能力单元契约。契约描述系统稳定需要的输入/输出/失败行为，不描述某个模型或实现。字段依据 LaYA-technical-roadmap-v0.3 §3.1，并记录本仓库扩展字段（milestone / forbidden / model_required / external_effects / authorization_basis）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "name",
    "purpose",
    "stage",
    "owner_type",
    "status",
    "milestone",
    "inputs",
    "outputs",
    "unknown_behavior",
    "forbidden",
    "external_effects",
    "model_required",
    "trace_fields",
    "test_strategy",
    "depends_on"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-(POL|DEM|INF|MEA|SEL|DEL|RUN|FBK|PUP)-[0-9]{2}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 12,
      "description": "要解决的问题。写可判定的目标，不写抽象愿望。"
    },
    "stage": {
      "enum": [
        "POLICY",
        "DEMAND",
        "INFORMATION",
        "MEASUREMENT",
        "SELECTION",
        "DELIVERY",
        "RUNTIME",
        "FEEDBACK",
        "POLICY_UPDATE"
      ],
      "description": "业务循环为 DEMAND/INFORMATION/MEASUREMENT/SELECTION/DELIVERY/FEEDBACK/POLICY_UPDATE；POLICY 与 RUNTIME 是本仓库为编排需要增加的非业务阶段（扩展 E-1），不得产出推荐决策。"
    },
    "owner_type": {
      "enum": [
        "DETERMINISTIC_CODE",
        "AI_AGENT",
        "RULE_SET",
        "MODEL_ADAPTER",
        "HUMAN_GATE",
        "HYBRID"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CONTRACTED",
        "IMPLEMENTED",
        "VERIFIED",
        "DEPRECATED"
      ]
    },
    "milestone": {
      "enum": [
        "M1",
        "M2",
        "M3"
      ],
      "description": "M1 离线最小链路；M2 真实来源+定时+推送；M3 反馈与规则演进。"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/io"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/io"
      }
    },
    "unknown_behavior": {
      "enum": [
        "MISSING",
        "UNKNOWN",
        "NOT_APPLICABLE",
        "INVALID",
        "ABSTAIN",
        "ERROR",
        "PARTIAL"
      ],
      "description": "证据不足或输入缺失时的默认确定行为，必须取自 docs/03-error-and-unknown-semantics.md。"
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "external_effects": {
      "type": "boolean",
      "description": "是否产生系统外部副作用（网络写入、推送、公开发布）。"
    },
    "authorization_basis": {
      "type": [
        "string",
        "null"
      ],
      "description": "external_effects 为 true 时必填：授权依据（如 USER_CONFIGURED）。"
    },
    "model_required": {
      "type": "boolean",
      "description": "该能力是否必须在运行时加载模型。"
    },
    "trace_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "test_strategy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-(POL|DEM|INF|MEA|SEL|DEL|RUN|FBK|PUP)-[0-9]{2}$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "external_effects": {
            "const": true
          }
        },
        "required": [
          "external_effects"
        ]
      },
      "then": {
        "required": [
          "authorization_basis"
        ],
        "properties": {
          "authorization_basis": {
            "type": "string",
            "minLength": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "SELECTION"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "owner_type": {
            "enum": [
              "RULE_SET",
              "DETERMINISTIC_CODE"
            ]
          },
          "model_required": {
            "const": false
          }
        },
        "description": "冻结约束 RULE_ENGINE_NO_MODEL：选择阶段不得由模型或 Agent 拥有，也不得在运行时加载模型。"
      }
    }
  ],
  "$defs": {
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*/[0-9]+\\.[0-9]+$",
          "description": "契约标识与主次版本，例如 DEMAND-SNAPSHOT/1.0。"
        },
        "required": {
          "type": "boolean"
        },
        "source_capability": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CAP-(POL|DEM|INF|MEA|SEL|DEL|RUN|FBK|PUP)-[0-9]{2}$"
        },
        "guarantees": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    }
  }
}
