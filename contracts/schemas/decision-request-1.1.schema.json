{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laya.local/contracts/decision-request/1.1",
  "title": "DecisionRequest",
  "description": "传给测量适配器的稳定请求。业务代码只依赖它，不依赖任何模型 SDK（v0.3 §5.3）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "capability_id",
    "state",
    "question",
    "language_context",
    "created_at",
    "contract_version"
  ],
  "properties": {
    "request_id": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-MEA-[0-9]{2}$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_text"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
        },
        "candidate_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "current_demand": {
          "type": "string",
          "maxLength": 4000
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://laya.local/contracts/common/1.0#/$defs/evidence_ref"
          },
          "uniqueItems": true
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instruction"
      ],
      "properties": {
        "type": {
          "enum": [
            "choice",
            "binary",
            "score"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,40}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "choice",
                  "binary"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "language_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_language",
        "judgment_language",
        "input_representation"
      ],
      "properties": {
        "source_language": {
          "$ref": "https://laya.local/contracts/common/1.0#/$defs/language_tag"
        },
        "retrieval_languages": {
          "type": "array",
          "items": {
            "$ref": "https://laya.local/contracts/common/1.0#/$defs/language_tag"
          },
          "uniqueItems": true
        },
        "judgment_language": {
          "$ref": "https://laya.local/contracts/common/1.0#/$defs/language_tag"
        },
        "input_representation": {
          "enum": [
            "ORIGINAL_SOURCE_TEXT",
            "TRANSLATION",
            "EXCERPT",
            "STRUCTURED_FIELDS"
          ]
        },
        "delivery_language_mode": {
          "enum": [
            "ZH_TRANSLATION",
            "ORIGINAL",
            "BILINGUAL"
          ]
        },
        "translation_ref": {
          "oneOf": [
            {
              "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "created_at": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/timestamp"
    },
    "contract_version": {
      "const": "1.1"
    }
  }
}
