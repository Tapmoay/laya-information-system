{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laya.local/contracts/rendered-brief/1.0",
  "title": "RenderedBrief",
  "description": "把 DeliveryObject 渲染成可读简报。呈现层只能表达交付对象里已有的内容：不得新增事实、不得改顺序、不得改结论（v0.3 §8.6）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "rendered_at",
    "delivery_ref",
    "format",
    "language_mode",
    "title",
    "body_markdown",
    "items",
    "warnings",
    "contract_version"
  ],
  "properties": {
    "brief_id": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
    },
    "rendered_at": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/timestamp"
    },
    "delivery_ref": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
    },
    "format": {
      "const": "MARKDOWN"
    },
    "language_mode": {
      "enum": [
        "ZH_TRANSLATION",
        "ORIGINAL",
        "BILINGUAL"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "priority_rank",
          "grouping",
          "original_title",
          "displayed_title",
          "source_url",
          "action"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
          },
          "priority_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "grouping": {
            "enum": [
              "CORE",
              "EXPLORATION",
              "VISUAL_MATCH",
              "VISUAL_EXPLORATION"
            ]
          },
          "original_title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "language": {
                "$ref": "https://laya.local/contracts/common/1.0#/$defs/language_tag"
              }
            }
          },
          "displayed_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_url": {
            "$ref": "https://laya.local/contracts/common/1.0#/$defs/http_url"
          },
          "why": {
            "type": "array",
            "items": {
              "$ref": "https://laya.local/contracts/common/1.0#/$defs/evidence_ref"
            },
            "uniqueItems": true
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300
            }
          },
          "action": {
            "enum": [
              "APPLY",
              "STUDY",
              "VERIFY",
              "MONITOR",
              "SAVE",
              "DISCARD"
            ]
          },
          "explanation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "description": "把已记录的测量标签翻译成人话；不得引入测量里没有的判断。"
          },
          "enrichment": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "headline_zh",
                  "summary_zh",
                  "relevance_by_direction",
                  "credibility",
                  "why_recommended",
                  "generated_by",
                  "not_evidence"
                ],
                "properties": {
                  "headline_zh": {"type": "string", "minLength": 4, "maxLength": 120},
                  "summary_zh": {"type": "string", "minLength": 10, "maxLength": 600},
                  "relevance_by_direction": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["direction", "level"],
                      "properties": {
                        "direction": {"type": "string", "minLength": 2, "maxLength": 40},
                        "level": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
                        "note": {"type": "string", "maxLength": 120}
                      }
                    }
                  },
                  "credibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["level"],
                    "properties": {
                      "level": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
                      "basis": {"type": "string", "maxLength": 200}
                    }
                  },
                  "why_recommended": {"type": "string", "minLength": 4, "maxLength": 300},
                  "generated_by": {"const": "AGENT"},
                  "not_evidence": {"const": true}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      }
    },
    "contract_version": {
      "const": "1.0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "language_mode": {
            "const": "ZH_TRANSLATION"
          }
        },
        "required": [
          "language_mode"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "displayed_title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
