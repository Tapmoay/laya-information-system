{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laya.local/contracts/policy-activation/1.0",
  "title": "PolicyActivation",
  "description": "规则激活记录。没有人工批准就不能产生这条记录（v0.3 WP-R9 的人工闸门）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_id",
    "proposal_ref",
    "diff_report_ref",
    "approved_by",
    "approved_at",
    "activated_at",
    "from_policy_version",
    "to_policy_version",
    "changes_applied",
    "rollback_to",
    "contract_version"
  ],
  "properties": {
    "activation_id": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
    },
    "proposal_ref": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
    },
    "diff_report_ref": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/identifier"
    },
    "approved_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "必须是具体的人；Agent 不能填自己。"
    },
    "approved_at": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/timestamp"
    },
    "activated_at": {
      "$ref": "https://laya.local/contracts/common/1.0#/$defs/timestamp"
    },
    "from_policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "to_policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "changes_applied": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "before",
          "after"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(/[A-Za-z0-9_]+)+$"
          },
          "before": {},
          "after": {}
        }
      }
    },
    "rollback_to": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "contract_version": {
      "const": "1.0"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "to_policy_version"
        ]
      },
      "then": {
        "properties": {
          "rollback_to": {
            "not": {
              "const": ""
            }
          }
        }
      }
    }
  ]
}
